############################################################
# RetroPick MarketEngine — Multi-chain deployment env (base)
#
# This repo’s Foundry scripts expect you to pass:
#   forge script ... --rpc-url "$RPC_URL" --ffi [--broadcast] [--account ...]
#
# Conventions in this file:
# - Primary RPC vars are per-chain:
#     <CHAIN>_MAINNET_RPC_URL / <CHAIN>_TESTNET_RPC_URL
# - You select a target and then export RPC_URL manually.
#
# Security:
# - Prefer Foundry keystore (`cast wallet import ...` + `--account <NAME>`)
# - Avoid putting a real PRIVATE_KEY in env for production.
############################################################

############################################################
# Active target (copy/paste one of the export blocks below)
############################################################
# Example:
# export TARGET_CHAIN=BASE
# export TARGET_NETWORK=TESTNET
# export RPC_URL="$BASE_TESTNET_RPC_URL"

TARGET_CHAIN=
TARGET_NETWORK=
RPC_URL=

############################################################
# Required by deployment scripts (all EVM chains)
# (script/production/DeployProduction.s.sol, script/test/DeployTestnet.s.sol)
############################################################

# Roles (control plane)
ADMIN=0x0000000000000000000000000000000000000000
TREASURY=0x0000000000000000000000000000000000000000
WORKER=0x0000000000000000000000000000000000000000

# Collateral token (ERC20 on target chain)
STAKE_TOKEN=0x0000000000000000000000000000000000000000

# Chainlink L2 sequencer uptime feed:
# - L1s: set to 0x000...000 (disabled)
# - L2s with Chainlink uptime feed: set the chain’s uptime feed proxy address
SEQUENCER_FEED=0x0000000000000000000000000000000000000000

# Protocol defaults (bounded by script requires)
DEFAULT_SETTLEMENT_FEE_BPS=100
MAX_SWITCH_FEE_BPS=200
MAX_OUTCOMES=8
ORACLE_MAX_DELAY_SECONDS=3600

# ChainlinkAdapter returns confidence=0; set to 0 for clarity (or a policy cap if you later support confidence-bearing oracles)
ORACLE_MAX_CONFIDENCE_BPS=0

############################################################
# Testnet-only options (script/test/DeployTestnet.s.sol)
############################################################

# Optional oracle smoke check through ChainlinkAdapter:
# If set, must be an AggregatorV3 proxy address on the target testnet.
SMOKE_FEED_ADDRESS=0x0000000000000000000000000000000000000000
SMOKE_MAX_AGE_SECONDS=3600

# Optional faucet + demo token deployment (only for testnet UX)
DEPLOY_FAUCET=0
FAUCET_TOKEN_NAME="Demo USD"
FAUCET_TOKEN_SYMBOL="dUSD"
FAUCET_COOLDOWN_SECONDS=3600
FAUCET_MAX_MINT_AMOUNT=1000000000000000000000

############################################################
# Upgrade scripts (script/test/UpgradeTestnet.s.sol, script/production/UpgradeProduction.s.sol)
############################################################
PROXY_ADDRESS=0x0000000000000000000000000000000000000000
NEW_CONTRACT="MarketEngine.sol:MarketEngine"

############################################################
# Legacy / local-only (script/UpgradeMarketEngine.s.sol, script/DeployLocal.s.sol)
# NOTE: production scripts recommend keystore instead.
############################################################
PRIVATE_KEY=

############################################################
# Chain matrix (mainnet + testnet) — RPC + explorer + chain id
#
# NOTE on naming:
# - All chain blocks use: <CHAIN>_(MAINNET|TESTNET)_{CHAIN_ID,RPC_URL,EXPLORER_URL,EXPLORER_API_KEY,SEQUENCER_FEED}
# - Even if a chain doesn’t use sequencer feeds, we include it (set to zero).
############################################################

############################################################
# 1) Base
############################################################
BASE_MAINNET_CHAIN_ID=8453
BASE_TESTNET_CHAIN_ID=84532
BASE_MAINNET_RPC_URL="https://mainnet.base.org"
BASE_TESTNET_RPC_URL="https://sepolia.base.org"
BASE_MAINNET_EXPLORER_URL="https://basescan.org"
BASE_TESTNET_EXPLORER_URL="https://sepolia.basescan.org"
BASE_MAINNET_EXPLORER_API_KEY=
BASE_TESTNET_EXPLORER_API_KEY=
# Chainlink sequencer uptime feed (from .docs/migrations/Chainlink.md)
BASE_MAINNET_SEQUENCER_FEED=0xBCF85224fc0756B9Fa45aA7892530B47e10b6433
BASE_TESTNET_SEQUENCER_FEED=0x0000000000000000000000000000000000000000

