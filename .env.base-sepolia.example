# Base Sepolia (testnet) runbook template
# Copy to: .env.base-sepolia

# --- RPC / account ---
RPC_URL=https://sepolia.base.org
KEYSTORE_NAME=your-keystore-name
EXPECTED_CHAIN_ID=84532

# Testnet deployer key (hex, 32 bytes). Used when you run `forge script ... --broadcast` without `--account`,
# and by scripts that read `PRIVATE_KEY` (e.g. UpgradeMarketEngine). Replace with your funded Base Sepolia key;
# never commit a real key—copy to a local env file listed in `.gitignore`, or export only in your shell.
# Placeholder below is Anvil account #0 (public); fine for local only—not for shared testnet deploys.
PRIVATE_KEY=0x47a7a5c023edca256316c32bb0f4ed7980fe37cafafd46c0fcf5142ab84a0ae0

# --- Core roles ---
ADMIN=0x4dbecc3495c5F8E7c73aaAa372b0eaE118806A95
TREASURY=0xc256F1B73eFa66b8F2e24551469ce66FA63d71f0
WORKER=0xaf8c2e5E7161191d0013Ca69Fb95bDB6F26e22A0

# --- Core collateral / oracle ---
STAKE_TOKEN=0x0000000000000000000000000000000000000000
SEQUENCER_FEED=0x0000000000000000000000000000000000000000

# --- Global protocol config ---
DEFAULT_SETTLEMENT_FEE_BPS=100
MAX_SWITCH_FEE_BPS=200
MAX_OUTCOMES=8
ORACLE_MAX_DELAY_SECONDS=3600
ORACLE_MAX_CONFIDENCE_BPS=500
OZ_UNSAFE_SKIP_ALL_CHECKS=0

# --- Optional TRO deployment ---
# TRUSTED_REPORTER=0x0000000000000000000000000000000000000000
# TRO_MAX_SIGNATURE_AGE_SECONDS=3600

# --- Optional testnet smoke ---
# SMOKE_FEED_ADDRESS=0x0000000000000000000000000000000000000000
# SMOKE_MAX_AGE_SECONDS=3600

# --- Optional faucet mode (DeployTestnet only) ---
# DEPLOY_FAUCET=1
# MAINNET_CHAIN_ID=1
# FAUCET_TOKEN_NAME=Demo USD
# FAUCET_TOKEN_SYMBOL=dUSD
# FAUCET_COOLDOWN_SECONDS=3600
# FAUCET_MAX_MINT_AMOUNT=1000000000000000000000

# --- Upgrade path ---
# PROXY_ADDRESS=0x0000000000000000000000000000000000000000
