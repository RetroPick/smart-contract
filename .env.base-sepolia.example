# Base Sepolia (testnet) runbook template
# Copy to `.env` at repo root (next to foundry.toml), or merge into your local `.env`.
# See also: `.env.example`

# --- RPC / account ---
RPC_URL=https://sepolia.base.org
EXPECTED_CHAIN_ID=84532

# `scripts/deploy-testnet.sh --broadcast` uses Foundry keystore `--account` (not PRIVATE_KEY).
# Preferred name in root `.env.example`; KEYSTORE_NAME is accepted as an alias (shell script fallback).
DEPLOY_ACCOUNT=your-keystore-name
# KEYSTORE_NAME=your-keystore-name

# --- PRIVATE_KEY (other scripts only) ---
# Used by scripts that read PRIVATE_KEY (e.g. some upgrade flows), NOT by `scripts/deploy-testnet.sh`.
# Replace for those tools; never commit a real key. Placeholder is Anvil #0 (local only).
# PRIVATE_KEY=0x47a7a5c023edca256316c32bb0f4ed7980fe37cafafd46c0fcf5142ab84a0ae0

# --- Core roles ---
ADMIN=0x4dbecc3495c5F8E7c73aaAa372b0eaE118806A95
TREASURY=0xc256F1B73eFa66b8F2e24551469ce66FA63d71f0
WORKER=0xaf8c2e5E7161191d0013Ca69Fb95bDB6F26e22A0

# --- Core collateral / oracle ---
# Stake token: set STAKE_TOKEN unless DEPLOY_FAUCET=1 (faucet deploys MockERC20).
# STAKE_TOKEN=0x0000000000000000000000000000000000000000

# L2 rollups: set Chainlink L2 sequencer uptime feed for this network (not a placeholder).
# Base Sepolia: confirm the feed on https://docs.chain.link/data-feeds/l2-sequencer-feeds
# (do not copy mainnet addresses). Use address(0) only where your chain/docs indicate L1-style testnet.
SEQUENCER_FEED=0x0000000000000000000000000000000000000000

# --- Global protocol config ---
DEFAULT_SETTLEMENT_FEE_BPS=100
MAX_SWITCH_FEE_BPS=200
MAX_OUTCOMES=8
ORACLE_MAX_DELAY_SECONDS=3600
ORACLE_MAX_CONFIDENCE_BPS=500
OZ_UNSAFE_SKIP_ALL_CHECKS=0

# --- Optional TRO deployment ---
# TRUSTED_REPORTER=0x0000000000000000000000000000000000000000
# TRO_MAX_SIGNATURE_AGE_SECONDS=3600

# --- Optional testnet smoke ---
# SMOKE_FEED_ADDRESS=0x0000000000000000000000000000000000000000
# SMOKE_MAX_AGE_SECONDS=3600

# --- Optional faucet mode (DeployTestnet only) ---
# DEPLOY_FAUCET=1
# MAINNET_CHAIN_ID=1
# FAUCET_TOKEN_NAME=Demo USD
# FAUCET_TOKEN_SYMBOL=dUSD
# FAUCET_COOLDOWN_SECONDS=3600
# FAUCET_MAX_MINT_AMOUNT=1000000000000000000000
#
# Gasless UX (API relayer) — set on the Go API host (see monorepo root `.env.example`):
# - FAUCET_RELAY_ENABLED=1
# - FAUCET_RELAYER_PRIVATE_KEY=<funded Base Sepolia EOA>
# - Users sign EIP-712 MintRequest; API submits TokenFaucet.requestWithSig.

# --- Block explorer (Basescan / verify) ---
# Same API key as Etherscan for Base: https://basescan.org/apis
# Used by: ./scripts/deploy-testnet.sh --broadcast --verify
#          ./scripts/verify-base-sepolia-contracts.sh
# ETHERSCAN_API_KEY=

# --- Upgrade path ---
# PROXY_ADDRESS=0x0000000000000000000000000000000000000000
