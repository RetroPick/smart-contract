# =============================================================================
# RetroPick v2 MarketEngine — environment template
# =============================================================================
# Copy to `.env` next to `foundry.toml` (this directory). Do not commit `.env`.
#
# Architecture (see `.docs/currentSmartContract.md`):
#   - UUPS proxy → `MarketEngineDispatcher` + delegatecall modules
#   - `ChainlinkAdapter(SEQUENCER_FEED)` as `IPriceOracle` (+ optional round id)
#   - Optional `YieldRouterV2` via `setYieldRouter` after deploy
#
# Forge scripts load these via `vm.envAddress` / `vm.envUint` / `vm.envOr`.
# Shell helpers in `scripts/deploy-*.sh` also read `RPC_URL`, `DEPLOY_ACCOUNT`, etc.
#
# Multi-chain / extended tables: `.docs/deployment/chain/.env.example.all`
# =============================================================================

# -----------------------------------------------------------------------------
# RPC & Foundry (used by shell wrappers and `forge script --rpc-url`)
# -----------------------------------------------------------------------------
RPC_URL=
# Alias some tools use:
# FOUNDRY_ETH_RPC_URL=

# Foundry keystore account name for `--account` (preferred over raw private keys)
DEPLOY_ACCOUNT=

# `scripts/deploy-mainnet.sh` only: must be `yes` to allow `--broadcast`
# ALLOW_MAINNET_BROADCAST=no

# High-level deploy gas bound (shell scripts default 50M if unset)
# GAS_LIMIT=50000000

# Block explorer verification (`forge script ... --verify`)
# ETHERSCAN_API_KEY=
# For non-Ethereum chains, set the appropriate verifier env vars your forge version expects.

# -----------------------------------------------------------------------------
# Core deploy — `script/Deploy.s.sol`, `script/production/DeployProduction.s.sol`
# -----------------------------------------------------------------------------
# Production requires all of the following. `initialize()` is atomic on the proxy.

# Governance multisig / protocol admin (templates, pause, UUPS, yield admin, etc.)
ADMIN=0x0000000000000000000000000000000000000000

# Receives `withdrawFees` payouts (transfer target is always this address)
TREASURY=0x0000000000000000000000000000000000000000

# Keeper / ops wallet: open/lock/resolve, rolling ticks, cancel (when not paused-only)
WORKER=0x0000000000000000000000000000000000000000

# Stake ERC20 — must not be fee-on-transfer (engine enforces balance delta on deposit)
STAKE_TOKEN=0x0000000000000000000000000000000000000000

# Chainlink L2 sequencer uptime feed passed to `ChainlinkAdapter` constructor:
#   L1:  0x0000000000000000000000000000000000000000
#   L2:  official Chainlink sequencer uptime proxy for the chain
SEQUENCER_FEED=0x0000000000000000000000000000000000000000

# Global defaults (per-template fees may be set in `upsertTemplate`)
# BPS caps: 0..10000. MAX_OUTCOMES <= 8 (engine compile-time cap).
DEFAULT_SETTLEMENT_FEE_BPS=100
MAX_SWITCH_FEE_BPS=200
MAX_OUTCOMES=8

# Oracle policy: max staleness (seconds) and max confidence band (bps).
# Adapter returns confidence 0 for Chainlink; cap still applies if you swap oracles.
ORACLE_MAX_DELAY_SECONDS=3600
ORACLE_MAX_CONFIDENCE_BPS=0

# -----------------------------------------------------------------------------
# Testnet deploy extras — `script/test/DeployTestnet.s.sol`
# -----------------------------------------------------------------------------
# If unset and DEPLOY_FAUCET=0, you must set STAKE_TOKEN above.
# DEPLOY_FAUCET=0
#
# Demo faucet + MockERC20 stake token (only when DEPLOY_FAUCET=1)
# FAUCET_TOKEN_NAME=Demo USD
# FAUCET_TOKEN_SYMBOL=dUSD
# FAUCET_COOLDOWN_SECONDS=3600
# FAUCET_MAX_MINT_AMOUNT=1000000000000000000000

# Optional: read a known AggregatorV3 proxy through the new adapter before wiring engine
# SMOKE_FEED_ADDRESS=0x0000000000000000000000000000000000000000
# SMOKE_MAX_AGE_SECONDS=3600

# -----------------------------------------------------------------------------
# UUPS upgrade — `script/test/UpgradeTestnet.s.sol`, `script/production/UpgradeProduction.s.sol`
# -----------------------------------------------------------------------------
PROXY_ADDRESS=0x0000000000000000000000000000000000000000

# FQN of the new implementation artifact (default matches dispatcher)
# NEW_CONTRACT=engine/MarketEngineDispatcher.sol:MarketEngineDispatcher

# -----------------------------------------------------------------------------
# Yield routing upgrade — `script/UpgradeMarketEngine_YieldRouting.s.sol`
# (runs `upgradeProxy` then optional `setYieldRouter` / `setLmRewardsEnabled`)
# -----------------------------------------------------------------------------
# YIELD_ROUTER=0x0000000000000000000000000000000000000000
# YIELD_FEE_BPS=0
# LM_REWARDS_ENABLED=false

# -----------------------------------------------------------------------------
# YieldRouterV2 deploy — `script/DeployYieldRouterV2.s.sol`
# -----------------------------------------------------------------------------
# Deployed router owner must register templates on-chain (`addTemplateSupport`, paths).
# Reuses STAKE_TOKEN from core section — same collateral as engine.
# AAVE_POOL=
# A_TOKEN=       # Aave aToken for STAKE_TOKEN reserve
# ENGINE_PROXY=  # MarketEngine UUPS proxy
# REWARDS_CONTROLLER=0x0000000000000000000000000000000000000000
# STATA_TOKEN=0x0000000000000000000000000000000000000000

# Legacy router — `script/DeployYieldRouterAaveV3.s.sol` (same STAKE_TOKEN, AAVE_POOL, A_TOKEN, ENGINE_PROXY)

# -----------------------------------------------------------------------------
# Modular pipeline — `script/modular/*.s.sol`
# -----------------------------------------------------------------------------
# `WORKER_AUTHORITY` is used here (same role as `WORKER` in monolithic deploy scripts).
# WORKER_AUTHORITY=0x0000000000000000000000000000000000000000
# PRICE_ORACLE=    # adapter address if oracle already deployed (10_DeployCore)
# ENGINE_PROXY=
# MODULE_ADMIN=
# MODULE_VIEW=
# MODULE_USEROPS_CLAIMS=
# MODULE_CORE_LIFECYCLE=
# MODULE_ROLLING_LIFECYCLE=

# `script/modular/90_Rollback.s.sol`
# ROLLBACK_SELECTOR=        # uint32 selector as decimal
# ROLLBACK_MODULE=

# -----------------------------------------------------------------------------
# Local / legacy only (avoid in production)
# -----------------------------------------------------------------------------
# Anvil default key — `script/DeployLocal.s.sol` only if you rely on env fallback
# PRIVATE_KEY=

# Older upgrade path — `script/UpgradeMarketEngine.s.sol`
# PRIVATE_KEY=
